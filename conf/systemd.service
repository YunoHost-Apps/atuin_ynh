# conf/atuin.service
[Unit]
Description=Atuin: Sync Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP__
Group=__APP__
#WorkingDirectory=__DATA_DIR__
#Environment=HOME=__DATA_DIR__
Environment=ATUIN_CONFIG_DIR=__INSTALL_DIR__
# configure RUST & Atuin logging
EnvironmentFile=-__INSTALL_DIR__/atuin.env

ExecStart=__INSTALL_DIR__/atuin-server start

Restart=on-failure
RestartSec=2
TimeoutStartSec=60
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

# Sandboxing options to harden security
# Details for these options: https://www.freedesktop.org/software/systemd/man/systemd.exec.html
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
# atuin-server binds a TCP port and uses UNIX sockets; it does not need AF_NETLINK
# (verified: startup + `atuin sync` OK without it on the live server).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# atuin-server only ever talks to nginx over the loopback interface
# (127.0.0.1:__PORT__), so restrict all IP traffic to localhost.
# Verified: `atuin sync` through nginx still works with this on the live server.
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
DevicePolicy=closed
ProtectClock=yes
ProtectHostname=yes
# ProtectHome is disabled on purpose. The app's DATA_DIR (SQLite DB) legitimately
# lives under /home (YunoHost convention /home/yunohost.app/__APP__):
#  - ProtectHome=yes masks /home and ReadWritePaths does NOT pierce it, so the
#    service crash-loops on "unable to open database file" (502).
#  - ProtectHome=tmpfs + BindReadWritePaths fails to build the mount namespace on
#    bookworm's systemd v252 (status=226/NAMESPACE).
# On a YunoHost app container /home holds no real user homes (only yunohost.app),
# so ProtectHome would protect almost nothing here. ProtectSystem=strict +
# ReadWritePaths below still confine writes to DATA_DIR.
ProtectHome=no
ProtectProc=invisible
ProcSubset=pid
# ProtectSystem=strict makes the whole FS read-only; the app only needs to
# write its SQLite DB, so grant write access to DATA_DIR only.
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
# atuin-server is a static Rust binary with no JIT, so it never needs writable+
# executable memory (verified: start + sync OK with W^X enforced).
MemoryDenyWriteExecute=yes
UMask=0077
SystemCallArchitectures=native
# Allowlist (deny-by-default) instead of a denylist: any syscall outside
# @system-service is blocked, including future/unknown ones. On top of that we
# still remove groups @system-service would otherwise allow. Verified: startup +
# `atuin sync` OK on the live server.
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @setuid

# Drop the entire capability bounding set. atuin-server runs as a non-root user
# (User=__APP__), listens on a high localhost port (127.0.0.1:__PORT__ behind
# nginx) and only writes a local SQLite DB, so it needs no capabilities at all.
# An empty set is stronger than the previous per-CAP denylist, which still left
# CAP_KILL/CAP_CHOWN/CAP_SETUID/... in the set. Verified: start + sync OK.
# Doc: https://man7.org/linux/man-pages/man7/capabilities.7.html
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

