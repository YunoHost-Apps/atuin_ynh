# conf/atuin.service
[Unit]
Description=Atuin: Sync Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP__
Group=__APP__
#WorkingDirectory=__DATA_DIR__
#Environment=HOME=__DATA_DIR__
Environment=ATUIN_CONFIG_DIR=__INSTALL_DIR__
# configure RUST & Atuin logging
EnvironmentFile=-__INSTALL_DIR__/atuin.env

ExecStart=__INSTALL_DIR__/atuin-server start

Restart=on-failure
RestartSec=2
TimeoutStartSec=60
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

# Sandboxing options to harden security
# Details for these options: https://www.freedesktop.org/software/systemd/man/systemd.exec.html
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
DevicePolicy=closed
ProtectClock=yes
ProtectHostname=yes
# ProtectHome is disabled on purpose. The app's DATA_DIR (SQLite DB) legitimately
# lives under /home (YunoHost convention /home/yunohost.app/__APP__):
#  - ProtectHome=yes masks /home and ReadWritePaths does NOT pierce it, so the
#    service crash-loops on "unable to open database file" (502).
#  - ProtectHome=tmpfs + BindReadWritePaths fails to build the mount namespace on
#    bookworm's systemd v252 (status=226/NAMESPACE).
# On a YunoHost app container /home holds no real user homes (only yunohost.app),
# so ProtectHome would protect almost nothing here. ProtectSystem=strict +
# ReadWritePaths below still confine writes to DATA_DIR.
ProtectHome=no
ProtectProc=invisible
ProcSubset=pid
# ProtectSystem=strict makes the whole FS read-only; the app only needs to
# write its SQLite DB, so grant write access to DATA_DIR only.
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation @privileged

# Denying access to capabilities that should not be relevant for webapps
# Doc: https://man7.org/linux/man-pages/man7/capabilities.7.html
CapabilityBoundingSet=~CAP_RAWIO CAP_MKNOD
CapabilityBoundingSet=~CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE
CapabilityBoundingSet=~CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_MODULE CAP_SYS_PACCT
CapabilityBoundingSet=~CAP_LEASE CAP_LINUX_IMMUTABLE CAP_IPC_LOCK
CapabilityBoundingSet=~CAP_BLOCK_SUSPEND CAP_WAKE_ALARM
CapabilityBoundingSet=~CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=~CAP_MAC_ADMIN CAP_MAC_OVERRIDE
CapabilityBoundingSet=~CAP_NET_ADMIN CAP_NET_BROADCAST CAP_NET_RAW
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYSLOG

[Install]
WantedBy=multi-user.target

